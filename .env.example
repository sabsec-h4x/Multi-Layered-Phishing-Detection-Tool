# ============================================================================
# PhishGuard — Environment Configuration Template
# ============================================================================
# Copy this file to ".env" and fill in your keys and settings.
# Never commit your actual ".env" file to version control.
#
# Threat Intelligence API Keys (All optional — free tiers available):
#   VirusTotal : https://www.virustotal.com/gui/join-us
#   URLScan.io : https://urlscan.io/user/signup
#   AbuseIPDB  : https://www.abuseipdb.com/register
#   URLHaus    : https://urlhaus.abuse.ch/api/
#   AlienVault : https://otx.alienvault.com/api
# ============================================================================

# Threat Intelligence Providers
VT_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
GSB_API_KEY=

# Application Settings
PHISHGUARD_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DATABASE_URL=sqlite:///phishguard.db

# Live URL Analyzer & SSRF Protection
FETCH_TIMEOUT=8
MAX_FETCH_BYTES=524288
MAX_REDIRECTS=5
ALLOW_PRIVATE_IPS=false

# Cache Configuration (TTL in seconds)
TI_CACHE_TTL_HOURS=24
DNS_CACHE_TTL_HOURS=12
WHOIS_CACHE_TTL_HOURS=48

# Rate Limiting & Concurrency
MAX_CONCURRENT_ENRICHMENTS=5
DEFAULT_IMAP_INTERVAL=30
